---
/* Заглушка первого дня: платформа собирается, ядро проверено тестами.
   Настоящая витрина курсов появится, когда будет что показывать. */
const ядро = [
  ['core/schema', 'проверка содержания: адрес ошибки и все беды разом'],
  ['content/registry', 'реестр блоков — единственная точка расширения'],
  ['content/model', 'курс: модули, темы, витки спирали, ссылки между витками'],
];
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Кибернетика — платформа</title>
  </head>
  <body>
    <h1>Платформа собирается</h1>
    <ul>
      {ядро.map(([путь, что]) => <li><code>{путь}</code> — {что}</li>)}
    </ul>
  </body>
</html>

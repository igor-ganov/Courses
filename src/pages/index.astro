---
/**
 * ТИТУЛ — обложка тетради.
 *
 * Здесь курс не пересказывается: пересказ — дело оглавления. Титул отвечает
 * на два вопроса, ради которых сюда заходят: что это за предмет и с чего
 * начать. Поэтому ссылок ровно две — «начать» и «оглавление», — а всё
 * остальное вычислено из плана и не переписано руками.
 */
import Foglio from '~/layouts/Foglio.astro';
import { PIANO } from '~/courses';
import { levelHref } from '~/content/inline';

const base = import.meta.env.BASE_URL;

const курсы = PIANO.courses.map((курс) => {
  const спираль = PIANO.spiralOrder(курс.id);
  const первый = спираль[0]!;
  return {
    курс,
    начало: levelHref(первый, { base, course: курс.id }),
    витков: курс.topics.reduce((n, т) => n + т.levels.length, 0),
    глубин: Math.max(...курс.topics.map((т) => т.levels.length)),
  };
});
---

<Foglio
  title="Кибернетика"
  description="Курс по кибернетике: обратная связь, разнообразие, информация, сложность. С приборами, которые можно крутить руками, и без сети."
>
  <main class="colonna copertina">
    <p class="sopra mano">Тетрадь по</p>
    <h1>Кибернетике</h1>

    <p class="occhiello">
      Дисциплина о том, что термостат, рука, тянущаяся к чашке, популяция рыбы и
      служба поддержки ломаются одинаково — и чинятся одинаково. Здесь она
      разобрана не пересказом, а приборами: каждый закон можно покрутить руками
      и увидеть, где он перестаёт работать.
    </p>

    {курсы.map(({ курс, начало, витков, глубин }) => (
      <section class="corso">
        <h2>{курс.title}</h2>
        {курс.subtitle && <p class="sottotitolo mano">{курс.subtitle}</p>}
        <p>{курс.description}</p>
        <p class="cifre tacito">
          {курс.modules.length} модуля · {курс.topics.length} тем · {витков} витков ·
          спираль в {глубин} прохода
        </p>
        <p class="scelte">
          <a class="bottone bottone--pieno" href={начало}>Начать</a>
          <a class="bottone" href={`${base}${курс.id}/`}>Оглавление</a>
        </p>
      </section>
    ))}

    <section class="promessa">
      <h2>Как это устроено</h2>
      <dl class="patti">
        <dt>Спираль, а не лестница</dt>
        <dd>
          Каждая тема встречается несколько раз. Первый виток — чтобы понять, о
          чём речь; второй — чтобы посчитать; третий — чтобы увидеть предел. Между
          витками стоят ссылки в обе стороны, и они проверяются при сборке: битой
          ссылки в тетради быть не может, потому что с ней она не собирается.
        </dd>

        <dt>Приборы, а не картинки</dt>
        <dd>
          Контур регулирования с запаздыванием и насыщением, игра в закон Эшби,
          канал с шумом и кодом Хаффмана, клеточные автоматы, удвоения периода,
          аттрактор Лоренца. Всё считается на устройстве, у каждой модели свои
          тесты, и ни один прибор не грузится, пока читатель до него не доехал.
        </dd>

        <dt>Без сети</dt>
        <dd>
          Однажды открытая тетрадь остаётся на устройстве целиком — вместе со
          шрифтами, приборами и отметками о пройденном. Прогресс хранится
          локально и никуда не отправляется: отправлять его некуда, сервера
          у тетради нет.
        </dd>

        <dt>Счёт по сделанному</dt>
        <dd>
          Опыт даётся за решённые работы, а не за открытые страницы, и убывает за
          перезаход. Освоенность — скользящее среднее оценок, поэтому одна
          удачная попытка не означает «знаю». Витки сами просятся на повторение
          через растущие промежутки.
        </dd>
      </dl>
    </section>
  </main>
</Foglio>

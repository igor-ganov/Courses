---
/**
 * ГАЛЕРЕЯ БЛОКОВ — что автору можно написать в лекции.
 *
 * Страница построена по реестру, а не по списку. Добавили блок — он здесь
 * появился со своим именем, пояснением и живым примером; ничего не надо
 * дописывать. Это и есть проверка того, что реестр — настоящая точка
 * расширения, а не украшение поверх зашитого перечня.
 *
 * Примеры лежат ниже. Их приходится писать руками — схема знает форму, но не
 * знает, что в блоке будет осмысленно, — и это единственный список, который
 * при добавлении блока надо пополнить. За тем, чтобы про него не забыли,
 * следит тест.
 */
import Foglio from '~/layouts/Foglio.astro';
import '~/blocks';
import { blockDefinitions, renderBlocks, type Block } from '~/content/registry';
import { ESEMPI } from '~/blocks/esempi';

const base = import.meta.env.BASE_URL;
const виды = blockDefinitions();

const образцы = виды.map((в) => {
  const пример = ESEMPI[в.kind];
  return {
    вид: в,
    интерактивный: typeof в.tag === 'string',
    разметка: пример ? renderBlocks([пример as Block], { base, course: 'cibernetica' }, в.kind) : '',
  };
});

const текстовых = образцы.filter((о) => !о.интерактивный).length;
---

<Foglio title="Из чего собраны страницы" description="Виды блоков, из которых складывается лекция: текст и приборы.">
  <main class="colonna galleria">
    <h1>Из чего собраны страницы</h1>
    <p class="occhiello">
      Лекция — это список блоков. Ни движок, ни маршрут, ни отображение не знают
      ни одного вида в лицо: все спрашивают реестр. Ниже — весь реестр целиком,
      в порядке регистрации, с живым примером каждого вида.
    </p>
    <p class="cifre tacito">
      {виды.length} видов · {текстовых} печатных · {виды.length - текстовых} приборов
    </p>

    {образцы.map(({ вид, интерактивный, разметка }) => (
      <section class="voce" id={вид.kind}>
        <h2>
          {вид.label}
          <code class="genere">{вид.kind}</code>
          <span class:list={['modo', интерактивный ? 'vivo' : 'stampa']}>
            {интерактивный ? `прибор · ${вид.tag}` : 'печатный'}
          </span>
        </h2>
        {вид.note && <p class="tacito">{вид.note}</p>}
        {разметка ? (
          <div class="campione" set:html={разметка} />
        ) : (
          <p class="guasto">Для этого вида не написан пример.</p>
        )}
      </section>
    ))}
  </main>
</Foglio>

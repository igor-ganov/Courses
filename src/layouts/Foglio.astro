---
/**
 * ЛИСТ — общая оболочка каждой страницы платформы.
 *
 * Порядок слоёв снизу вверх: освещённая материя (WebGL), печатная клетка,
 * поле, содержание. Материя и клетка едут вместе с текстом — обе размером с
 * окно, прилипание делает сдвиг фона, иначе браузер красит полотно во весь
 * документ и первая отрисовка встаёт.
 *
 * Три скрипта, и порядок между ними не случаен:
 *
 *   1. Острова и игра — модуль, собранный сборщиком. Он и включает приборы,
 *      и помечает состояние. Грузится с `type=module`, то есть отложенно, но
 *      до простоя: без него страница читается, но не считается.
 *   2. Материя — украшение, поэтому в простое и последней.
 *   3. Служитель — в `load`, чтобы регистрация не мешала первой отрисовке.
 *
 * Ни один из трёх не обязателен: без всех трёх остаётся полная лекция на
 * крашеной бумаге. Это и есть проверка на то, что слои разделены честно.
 */
import '~/styles/quaderno.css';
/* Три файла, с которых начинается всякая страница: наборное для текста —
   прямое и полужирное, — и рукописное для заголовка. В каждом кириллица,
   цифры и знаки препинания; латинские буквы, греческие и математические
   знаки лежат отдельно и приезжают, только если встретились.

   Предзагрузка нужна из-за font-display: optional. Он даёт браузеру сто
   миллисекунд и, если шрифт не приехал, оставляет запасной до конца
   загрузки — ни подмен, ни сдвигов. Без предзагрузки браузер узнаёт о
   шрифте, только разобрав стиль, и в сто миллисекунд не укладывается
   никогда; с ней загрузка идёт вместе со стилем и успевает.

   Адреса с отпечатками известны только сборщику, поэтому берутся импортом,
   а не пишутся строкой. */
import caveat from '~/assets/fonts/caveat-sempre.woff2?url';
import literata from '~/assets/fonts/literata-sempre.woff2?url';
import literataGrasso from '~/assets/fonts/literata-b-sempre.woff2?url';
import lit_i from '~/assets/fonts/literata-i-sempre.woff2?url';
import mono from '~/assets/fonts/pt-mono-sempre.woff2?url';

const СНАЧАЛА = [literata, literataGrasso, caveat, lit_i, mono];

interface Props {
  title: string;
  description?: string;
  /** Курс, к которому относится страница: он ведёт хлебные крошки. */
  course?: { id: string; title: string } | undefined;
}

const { title, description, course } = Astro.props;
const base = import.meta.env.BASE_URL;
const полный = title.endsWith('Кибернетика') ? title : `${title} — Кибернетика`;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{полный}</title>
    {description && <meta name="description" content={description} />}
    {СНАЧАЛА.map((путь) => (
      <link rel="preload" href={путь} as="font" type="font/woff2" crossorigin />
    ))}
    <meta name="theme-color" content="#f3efe4" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}icona.svg`} type="image/svg+xml" />
    {/* apple-touch-icon указывал на тот же SVG, и это была двойная загрузка
        ни за чем: iOS растровый значок и берёт только из манифеста при
        добавлении на экран, а SVG для этой роли не понимает вовсе. */}
  </head>
  <body>
    <canvas
      data-materia
      data-carta="f7f3e8"
      data-ombra="9a917f"
      data-luce="fff7e6"
      data-rilievo="11"
      data-fibra="0.055"
      data-calore="0.05"></canvas>
    <div class="griglia" data-scorre data-passo></div>
    <div class="margine"></div>

    <header class="testata">
      <nav class="briciole" aria-label="Где я">
        <a href={base}>Тетрадь</a>
        {course && <><span aria-hidden="true">·</span><a href={`${base}${course.id}/`}>{course.title}</a></>}
      </nav>
      <div class="stato" data-stato-gioco data-ripasso={`${base}ripasso/`} aria-live="polite"></div>
    </header>

    <slot />

    <footer class="piede">
      <p class="tacito">
        Тетрадь по кибернетике. Работает без сети: однажды открытые витки
        остаются на устройстве. <a href={`${base}blocchi/`}>Из чего собраны страницы</a>.
      </p>
    </footer>

    <script>
      import { accendiIsole } from '~/scripts/isole';
      import { avviaGioco } from '~/scripts/gioco';
      accendiIsole();
      avviaGioco();
    </script>

    <script is:inline define:vars={{ base }}>
      /* Материя грузится по первому касанию, и это не откладывание ради
         цифры в отчёте.

         Прогиб бумаги существует затем, чтобы отвечать на палец: без пальца
         он ничего не показывает. А стоит он дорого — компиляция шейдера и
         сборка карты смещений занимают около двухсот миллисекунд на
         замедленном вчетверо телефоне, и раньше они приходились ровно на то
         время, когда читатель пытается начать читать.

         Поэтому скрипт запрашивается по первому же признаку присутствия —
         касанию, нажатию, прокрутке, клавише. Ни байта до этого: даже
         prefetch на самом низком приоритете отнимает семнадцать килобайт
         полосы у текста, который читатель ждёт прямо сейчас. Первое касание
         поэтому прогиба не даёт — он появляется со второго; это дешевле,
         чем задержка для всех, включая тех, кто пришёл почитать и бумагу
         не трогает. */
      const адрес = `${base}materia/materia.js`;

      let поставлена = false;
      const поставить = () => {
        if (поставлена) return;
        поставлена = true;
        for (const событие of СИГНАЛЫ) removeEventListener(событие, поставить, ПАССИВНО);
        const s = document.createElement('script');
        s.src = адрес;
        s.defer = true;
        document.head.appendChild(s);
      };
      const СИГНАЛЫ = ['pointerdown', 'touchstart', 'wheel', 'keydown', 'scroll'];
      const ПАССИВНО = { passive: true, once: false };
      for (const событие of СИГНАЛЫ) addEventListener(событие, поставить, ПАССИВНО);

      /* Служитель делает курс доступным без сети. Регистрация после загрузки:
         до первой отрисовки ей нечего делать, а мешать она умеет. */
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch(() => {
            /* Отказ регистрации — это отказ от офлайна, а не от страницы. */
          });
        });
      }
    </script>
  </body>
</html>

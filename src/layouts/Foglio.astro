---
/**
 * ЛИСТ — общая оболочка каждой страницы платформы.
 *
 * Порядок слоёв снизу вверх: освещённая материя (WebGL), печатная клетка,
 * поле, содержание. Материя и клетка едут вместе с текстом — обе размером с
 * окно, прилипание делает сдвиг фона, иначе браузер красит полотно во весь
 * документ и первая отрисовка встаёт.
 *
 * Три скрипта, и порядок между ними не случаен:
 *
 *   1. Острова и игра — модуль, собранный сборщиком. Он и включает приборы,
 *      и помечает состояние. Грузится с `type=module`, то есть отложенно, но
 *      до простоя: без него страница читается, но не считается.
 *   2. Материя — украшение, поэтому в простое и последней.
 *   3. Служитель — в `load`, чтобы регистрация не мешала первой отрисовке.
 *
 * Ни один из трёх не обязателен: без всех трёх остаётся полная лекция на
 * крашеной бумаге. Это и есть проверка на то, что слои разделены честно.
 */
import '~/styles/quaderno.css';

interface Props {
  title: string;
  description?: string;
  /** Курс, к которому относится страница: он ведёт хлебные крошки. */
  course?: { id: string; title: string } | undefined;
}

const { title, description, course } = Astro.props;
const base = import.meta.env.BASE_URL;
const полный = title.endsWith('Кибернетика') ? title : `${title} — Кибернетика`;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{полный}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#f3efe4" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" href={`${base}icona.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icona.svg`} />
  </head>
  <body>
    <canvas
      data-materia
      data-carta="f7f3e8"
      data-ombra="9a917f"
      data-luce="fff7e6"
      data-rilievo="11"
      data-fibra="0.055"
      data-calore="0.05"></canvas>
    <div class="griglia" data-scorre></div>
    <div class="margine" data-scorre></div>

    <header class="testata">
      <nav class="briciole" aria-label="Где я">
        <a href={base}>Тетрадь</a>
        {course && <><span aria-hidden="true">·</span><a href={`${base}${course.id}/`}>{course.title}</a></>}
      </nav>
      <div class="stato" data-stato-gioco data-ripasso={`${base}ripasso/`} aria-live="polite"></div>
    </header>

    <slot />

    <footer class="piede">
      <p class="tacito">
        Тетрадь по кибернетике. Работает без сети: однажды открытые витки
        остаются на устройстве. <a href={`${base}blocchi/`}>Из чего собраны страницы</a>.
      </p>
    </footer>

    <script>
      import { accendiIsole } from '~/scripts/isole';
      import { avviaGioco } from '~/scripts/gioco';
      accendiIsole();
      avviaGioco();
    </script>

    <script is:inline define:vars={{ base }}>
      /* Материя — украшение, поэтому грузится последней и в простое: страница
         обязана быть читаемой до неё и без неё. */
      const поставить = () => {
        const s = document.createElement('script');
        s.src = `${base}materia/materia.js`;
        s.defer = true;
        document.head.appendChild(s);
      };
      if ('requestIdleCallback' in window) requestIdleCallback(поставить, { timeout: 1500 });
      else addEventListener('load', поставить);

      /* Служитель делает курс доступным без сети. Регистрация после загрузки:
         до первой отрисовки ей нечего делать, а мешать она умеет. */
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch(() => {
            /* Отказ регистрации — это отказ от офлайна, а не от страницы. */
          });
        });
      }
    </script>
  </body>
</html>
